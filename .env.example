# Copiar a .env (gitignored). Nunca subas .env al repositorio.

# --- PostgreSQL (requeridos) ---
# URL que usa la aplicacion en runtime. Driver: postgresql+psycopg.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/sipanalert_db
# URL que usa Alembic para correr migraciones. Normalmente igual a DATABASE_URL;
# puede diferir si las migraciones las ejecuta un usuario con mas privilegios.
DATABASE_MIGRATION_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/sipanalert_db

# --- Sesion FastAPI ---
# Secreto para firmar la cookie de sesion. Obligatorio en produccion.
# En desarrollo local, si no se define, api/main.py usa "sipanalert-local-development-only".
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIPAN_SESSION_SECRET=cambia-este-valor-en-produccion

# --- Gemini (opcional) ---
# Sin la API key, el chatbot FAQ y la verificacion web usan solo el catalogo local.
GEMINI_API_KEY=
# Modelo para busqueda/verificacion web. Default: gemini-2.5-flash.
GEMINI_SEARCH_MODEL=gemini-2.5-flash
